{
  "theme": {
    "aside": { "border-radius": "16px", "border-width": "3px", "border-style": "double" },
    "border-radius": "0",
    "button": { "border-radius": "16px", "border-width": "1px", "border-style": "solid" },
    "code":   { "border-radius": "16px", "border-width": "1px", "border-style": "solid" },
    "color": {
      "mysqlnio": "#02758f",
      "documentation-intro-fill": {
        "dark":  "radial-gradient(circle at top, var(--color-mysqlnio)  0%, #000000 100%)",
        "light": "radial-gradient(circle at top, var(--color-mysqlnio)  0%, #f0f0f0 100%)"
      },
      "documentation-intro-accent": "var(--color-mysqlnio)",
      "hero-eyebrow": { "dark": "#fff", "light": "#000" },
      "documentation-intro-figure": { "dark": "#fff", "light": "#000" },
      "hero-title": { "dark": "#fff", "light": "#000" },
      "logo-base":  { "dark": "#f1f1f1", "light": "#111" },
      "logo-shape": { "dark": "#111", "light": "#f1f1f1" },
      "fill":       { "dark": "#000", "light": "#fff" }
    },
    "icons": { "technology": "/mysqlnio/images/MySQLNIO/vapor-mysqlnio-logo.svg" }
  },
  "features": {
    "quickNavigation": { "enable": true },
    "i18n": { "enable": true }
  }
}
